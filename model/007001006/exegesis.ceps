exegesis{
built_in_data_type_representations{
 unsigned_int{
  decode{
    uint64{
     interface{ 
       args{
        buffer{ARG0;};
       };
       res{
         value{RES;};
         consumed_bytes{R0;};
       };
       ev{
        kind Event;
        Event DecodeVarUIntToUint64;
        DecodeVarUIntToUint64;
       };
      };
    };
  };
 };
};
};
kind Event;
Event DecodeVarUIntToUint64Successful;

exegesis{
built_in_data_type_representations{
 unsigned_int{
  decode{
    uint64{
     impl_inline{
     oblectamenta{text{asm{
      //Multiple 'tricks' used here to make the code more readable.
      // 1. Code parts are pulled from different locations via document path expressions, i.e. expressions of the form root.A.B...
      // 2. values defined via val are actually evaluated during compile time this allows us ... 
      // 3. ... to give registers a telling name, e.g. val input = R5 allows us to use 'input' everywhere where R5 is allowed.
      
      // Pull interface declaratin, in this case the name of the register which holds the pointer to the input buffer
      
      val input_buffer = root.exegesis.built_in_data_type_representations.unsigned_int.decode.uint64.interface.args.buffer.content();

      // labels we gonna use
      OblectamentaCodeLabel loop;
      OblectamentaCodeLabel loop_exit;
      
      // Give regisers we use telling names
      val value = RES; // Decoded value is stored in RES. 
      val multiplier_lg = R2; // Multiplier (lg stands for logarithm with respect to basis 2) resides in R2.
      val encoded_value_addr = input_buffer;
      val encoded_value_idx = R4;
      val encoded_value_current_byte = R5;
     
      ldi64(0);              // |      
      sti64(value);          // value = 0   
      ldi64(0);              // |
      sti64(multiplier_lg);  // multiplier = lg(1) = 0 
      invariant{value == 0; multiplier_lg == 0; bitwidth(value) == 64;};
     
      ldi64(0);                 // |
      sti64(encoded_value_idx); // encoded_value_idx = 0
    loop;
      ldi64(encoded_value_addr);         // |
      ldi64(encoded_value_idx);          // |
      addi64;                            // |
      ldsi8;                             // |
      ui8toui64;                         // |
      ldi64(127);                        // |
      andi64;                            // |
      sti64(encoded_value_current_byte); // encoded_value_current_byte = 0x7f & encoded_value_addr[encoded_value_idx]
     ldi32(multiplier_lg);
     ldi64(encoded_value_current_byte);
     shli64;
     ldi64(value);
     addi64;
     sti64(value);
     ldi32(128);
     ldi64(encoded_value_addr);
     ldi64(encoded_value_idx);
     addi64;
     ldsi8;
     ui8toui32;
     blt(loop_exit);
     ldi64(encoded_value_idx);
     ldi64(1);
     addi64;
     sti64(encoded_value_idx);
     ldi32(multiplier_lg);
     ldi32(7);
     addi32;
     sti32(multiplier_lg);
     buc(loop);
    loop_exit;
    };};};

     };//impl_inline
   };
 };
};
};
};

exegesis{

OblectamentaDataLabel input_unsigned_int_0;
OblectamentaDataLabel input_unsigned_int_1;
OblectamentaDataLabel input_unsigned_int_128, input_unsigned_int_256, input_unsigned_int_16384, input_unsigned_int_2097152;
OblectamentaDataLabel global_msg_buffer;

oblectamenta{
 global{
  data{
    1;
    input_unsigned_int_0;
    as_uint8(0);           // |000000000|
    input_unsigned_int_1;
    as_uint8(1);           // |000000001|
    input_unsigned_int_128;
    as_uint8(128);
    as_uint8(1);           // |100000000|00000001|
    input_unsigned_int_256;
    as_uint8(128);
    as_uint8(2);           // |100000000|00000010|
    input_unsigned_int_16384;
    as_uint8(128);
    as_uint8(128);
    as_uint8(1);           // |100000000|100000000|00000001|
    input_unsigned_int_2097152;
    as_uint8(128);
    as_uint8(128);
    as_uint8(128);
    as_uint8(1);           // |100000000|100000000|100000000|00000001|
    global_msg_buffer; for(i : 1 .. 64){0;}
  };
 };
};


sm{
 DecodeUnsignedIntegerui64;
 states{Initial;Decode;};
 Actions{
  doDecode{
   oblectamenta{text{asm{
    val buffer_addr = root.exegesis.built_in_data_type_representations.unsigned_int.decode.uint64.interface.args.buffer.content();

    msg{
      OblectamentaMsgReadDirective read;
      read;global_msg_buffer;
      buffer{
        OblectamentaMessageTag i64;
        i64;
        sti64(buffer_addr);
      };
    };
    root.exegesis.built_in_data_type_representations.unsigned_int.decode.uint64.impl_inline.oblectamenta.text.asm.content();
    DecodeVarUIntToUint64Successful(
      msg{
        OblectamentaMsgDefDirective write;OblectamentaMessageTag i64;
        write; global_msg_buffer;
        value{
          ldi64(RES);
          i64;          
        };
      }
    );
   };};};
  };
 };
 t{Initial;Decode;root.exegesis.built_in_data_type_representations.unsigned_int.decode.uint64.interface.ev.content();doDecode;};
};// sm EncodeUnsignedInteger

Event UInt64DecodeTestSuccessful;
Event UInt64DecodeTestFail;

sm{
  TestDecoder;
  val evDoDecodeUint64 = root.exegesis.built_in_data_type_representations.unsigned_int.decode.uint64.interface.ev.content();
  Actions{
   doTest1{
    oblectamenta{text{asm{
      evDoDecodeUint64(
      msg{
        OblectamentaMsgDefDirective write;OblectamentaMessageTag i64;
        write; global_msg_buffer;
        buffer{
         lea(input_unsigned_int_256);
         i64;
        };
      });
    };};};
   };
   doTest1Check{
    oblectamenta{text{asm{
      OblectamentaCodeLabel ok;
      msg{
        OblectamentaMsgReadDirective read;OblectamentaMessageTag i64;
        read; global_msg_buffer;
        value{
          i64;
          sti64(R0);          
        };
      };//msg
      
      ldi64(R0);
      ldi64(256);
      beqi64(ok);
      dbg_print_cs_and_regs(0);halt;
      UInt64DecodeTestFail;
      halt;
      ok;
      UInt64DecodeTestSuccessful;
    };};};
   }; //doTest1Check

  };//Actions
  states{Initial;WaitForResult;Check;CheckOK;CheckNOK;Final;};
  t{Initial;WaitForResult;doTest1;};
  t{WaitForResult;Check;DecodeVarUIntToUint64Successful;doTest1Check;};
  t{Check;CheckOK;UInt64DecodeTestSuccessful;};
  t{Check;CheckNOK;UInt64DecodeTestFail;};

};

};